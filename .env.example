# ==============================================================================
# IncidentPilot - Environment Variables Template
# ==============================================================================
# Copy this file to .env or export these variables in your environment.
# NEVER commit real API keys or credentials to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Hindsight Long-Term Memory Service
HINDSIGHT_BASE_URL=https://api.hindsight.ai
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_SECONDS=5
HINDSIGHT_ENDPOINT_RECALL=
HINDSIGHT_ENDPOINT_RETAIN=
HINDSIGHT_ENDPOINT_REFLECT=

# LLM Provider Configuration (OpenAI, Gemini OpenAI-compatible proxy, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini